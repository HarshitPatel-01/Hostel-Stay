<% layout("./layouts/boilerplate") %>

<div class="container py-4">
  <!-- Title -->
  <h2 class="fw-semibold mb-3"><%= listing.title %></h2>
  <p class="text-muted mb-4">
    <i class="fa-solid fa-location-dot me-1"></i>
    <%= listing.location %>, <%= listing.country %>
  </p>

  <!-- Image + Details -->
  <div class="row">
    <div class="col-md-7">
      <img
        src="<%= listing.image?.url || listing.image || 'https://images.unsplash.com/photo-1507525428034-b723cf961d3e' %>"
        class="img-fluid rounded-4 shadow-sm mb-4"
        alt="listing image"
      />
    </div>

    <div class="col-md-5">
      <div class="p-4 border rounded-4 shadow-sm mb-4">
        <h4 class="fw-semibold mb-2">₹ <%= listing.price.toLocaleString("en-IN") %> / night</h4>
        <p><%= listing.description %></p>

        <% if (currentUser) { %>
          <a href="/listings/<%= listing._id %>/edit" class="btn btn-outline-dark btn-sm me-2">
            <i class="fa-solid fa-pen"></i> Edit
          </a>

          <form method="POST" class="d-inline" action="/listings/<%= listing._id %>?_method=DELETE">
            <button class="btn btn-outline-danger btn-sm">
              <i class="fa-solid fa-trash"></i> Delete
            </button>
          </form>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Reviews -->
  <hr class="my-4">

  <h4 class="fw-semibold mb-3">Reviews</h4>

  <% if (currentUser) { %>
    <form 
      action="/listings/<%= listing._id %>/reviews"
      method="POST"
      class="p-4 border rounded-4 shadow-sm mb-4"
    >
      <label class="form-label fw-semibold">Rating</label>
      <input type="range" min="1" max="5" name="review[rating]" class="form-range mb-3">

      <label class="form-label fw-semibold">Comments</label>
      <textarea
        name="review[comment]"
        rows="3"
        class="form-control mb-3"
        required
      ></textarea>

      <button class="btn btn-dark w-100">Submit Review</button>
    </form>
  <% } else { %>
    <p class="text-muted ms-1">Please <a href="/login">log in</a> to leave a review.</p>
  <% } %>

  <div class="row g-3">
    <% if (listing.reviews.length === 0) { %>
      <p class="text-muted ms-1">No reviews yet — be the first!</p>
    <% } %>

    <% for (let review of listing.reviews) { %>
      <div class="col-md-5">
        <div class="border rounded-4 p-3 shadow-sm h-100">
          <p class="mb-1"><strong>⭐ <%= review.rating %> / 5</strong></p>
          <p class="text-muted"><%= review.comment %></p>

          <% if (currentUser) { %>
            <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
              <button class="btn btn-sm btn-outline-dark">
                <i class="fa-solid fa-trash"></i> Remove
              </button>
            </form>
          <% } %>
        </div>
      </div>
    <% } %>
  </div>
</div>
